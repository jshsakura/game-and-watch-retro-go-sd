+/* Composite the MD lines drawn so far (with the palette they were drawn
+ * under) before that palette is replaced, or before deferral is given up. */
+void Pico32xMdFlush(void)
+{
+  int line = Pico.est.DrawScanline;
+  void *dest;
+  int incr;
+
+  if (!gnw_md_defer || gnw_md_nof || Pico32x.sync_line >= line)
+    return;
+  dest = Pico.est.DrawLineDest;
+  incr = Pico.est.DrawLineDestIncr;
+  Pico32xRenderSync(line);
+  Pico.est.DrawLineDest = dest;
+  Pico.est.DrawLineDestIncr = incr;
+  Pico32x.sync_line = line;
+}
+
+void Pico32xMdAbort(void)
+{
+  if (!gnw_md_defer)
+    return;
+  Pico32xMdFlush();
+  gnw_md_defer = 0;
+  Pico.est.rendstatus |= PDRAW_SYNC_NEEDED;
+}
