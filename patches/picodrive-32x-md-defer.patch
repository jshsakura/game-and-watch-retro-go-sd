+  /* Deferred MD layer: H40, no line callbacks. Everything else keeps the old
+   * rule that the MD layer is redrawn into the output buffer every frame. */
+  gnw_md_defer = Pico32xDrawMode == PDM32X_32X_ONLY && (Pico.video.reg[12] & 1) &&
+                 PicoScanBegin == NULL && PicoScan32xBegin == NULL;
+  if (Pico32xDrawMode != PDM32X_BOTH && !gnw_md_defer)
     Pico.est.rendstatus |= PDRAW_SYNC_NEEDED;
   PicoFrameHints();
 
