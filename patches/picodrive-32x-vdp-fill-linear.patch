+/* GNW_FILL_BEGIN */
+/* VDP autofill: the address wraps inside a 256-halfword line (the high byte of
+ * a is kept, the low byte wraps) and d is constant, so the result is the set
+ * of cells the walk touches: [lo, lo+len) if it does not wrap, otherwise the
+ * rest of the line plus [0, min(len - rem, 256)) because a second full pass
+ * changes nothing. This skips the per-halfword address step and the repeated
+ * writes to the same cells. tests/test_vdp_fill_linear.sh compares it with the
+ * original loop for every start and every length up to 4 lines. */
+static inline void gnw_vdp_fill(u16 *dram, u32 a, u32 len, u16 d)
+{
+  u16 *line = dram + (a & 0xff00);
+  u32 lo = a & 0xff, rem = 0x100 - lo, i;
+
+  if (len < rem) {
+    for (i = 0; i < len; i++)
+      line[lo + i] = d;
+    return;
+  }
+  for (i = lo; i < 0x100; i++)
+    line[i] = d;
+  len -= rem;
+  if (len > 0x100)
+    len = 0x100;
+  for (i = 0; i < len; i++)
+    line[i] = d;
+}
+/* GNW_FILL_END */
+
