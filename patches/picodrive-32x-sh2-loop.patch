+#ifndef DRC_SH2
+/* Interpreter loop stop limit. The dispatch loop continues while
+ * icount > SH2_ILIM(sh2). It is 0 normally; whoever raises test_irq also
+ * raises the limit so the loop leaves its fast path right after the current
+ * instruction (and its delay slot), where the pending interrupt is serviced.
+ * That replaces a test_irq load+branch on every instruction. irq_cycles is
+ * the DRC's field and unused by the interpreter. */
+#define SH2_ILIM(sh2) ((sh2)->irq_cycles)
+#define SH2_ILIM_STOP 0x7fffffff
+#define SH2_RAISE_IRQ_TEST(sh2) do { (sh2)->test_irq = 1; SH2_ILIM(sh2) = SH2_ILIM_STOP; } while (0)
+#else
+#define SH2_RAISE_IRQ_TEST(sh2) ((sh2)->test_irq = 1)
+#endif
