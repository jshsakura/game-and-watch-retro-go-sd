# TamaPoke private build: the sprite packs are CC BY-NC and depict Nintendo
# characters. Generated locally, never committed, never uploaded.
/upload/
/tamapoke_sd_payload*.zip
Core/Src/porting/tamapoke/mons/
*.tpk2

# PokeAPI responses cached by tools/tamapoke/make_dex_names.py. They carry the
# localised species names verbatim -- the very thing kept out of this tree.
.pokeapi_cache/

# gwemu emulator binary (downloaded, lives at repo root so make clean does not wipe it)
gwemu_bin
gwemu_bin.version
.gwemu_tmp/
# On macOS gwemu ships as an .app bundle whose executable loads its dylibs from
# a sibling Frameworks/ dir, so the bundle is kept and gwemu_bin symlinks into it.
gwemu.app/

# Session logs from scripts/run_gwemu.sh. The default (build/gwemu.log) is already
# covered by build/, but --log-file can point anywhere. No .log files are tracked.
*.log
.gwemu_release_cache
tools/pico_host/build/

# Host build artefact of the WAD packer (external/nh-doom/MCUDoomWadUtil).
# Compiled per-machine; an aarch64 ELF has no business in a firmware tree.
external/nh-doom/MCUDoomWadUtil/mcuwad
