diff --git a/Makefile.common b/Makefile.common
index 779f5e6f..3a74dce3 100644
--- a/Makefile.common
+++ b/Makefile.common
@@ -1559,6 +1559,10 @@ endif
 # be taken with nobody at the console. By index, not path -- the launcher's paths
 # come from FatFs and a literal need not match them byte for byte. Diagnostic.
