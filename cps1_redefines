# CPS-1 overlay symbol privatisation.
#
# Every core overlay links at the same RAM_EMU address, so two overlays that
# both define a symbol collide at link time (multiple definition) -- and a
# core that only REFERENCES another's symbol gets silently aliased to it
# instead, which is worse (CLAUDE.md, "Cores are overlays"). CPS-1 compiles
# its own copy of Musashi, which Sega Genesis and Sega CD also compile, so
# every symbol m68kcpu.c exports outside the cps1_/CPS1_ namespace is renamed
# here. Generated from nm -g --defined-only over build/cps1/*.o; app_main_cps1
# is deliberately NOT renamed because the launcher calls it by name.
#
# old                        new
gwenesis_m68k_load_state cps1__gwenesis_m68k_load_state
gwenesis_m68k_save_state cps1__gwenesis_m68k_save_state
m68k cps1__m68k
m68k_clear_halt cps1__m68k_clear_halt
m68k_cycles cps1__m68k_cycles
m68k_cycles_master cps1__m68k_cycles_master
m68k_cycles_run cps1__m68k_cycles_run
m68k_get_reg cps1__m68k_get_reg
m68k_init cps1__m68k_init
m68k_pulse_halt cps1__m68k_pulse_halt
m68k_pulse_reset cps1__m68k_pulse_reset
m68k_run cps1__m68k_run
m68k_set_int_ack_callback cps1__m68k_set_int_ack_callback
m68k_set_irq cps1__m68k_set_irq
m68k_set_irq_delay cps1__m68k_set_irq_delay
m68k_set_reg cps1__m68k_set_reg
m68k_update_irq cps1__m68k_update_irq
vdp_68k_irq_ack cps1__vdp_68k_irq_ack
