diff --git a/pce-go/components/pce-go/h6280_instr.h b/pce-go/components/pce-go/h6280_instr.h
index 5fea048..732a507 100644
--- a/pce-go/components/pce-go/h6280_instr.h
+++ b/pce-go/components/pce-go/h6280_instr.h
@@ -2440,6 +2440,17 @@ OPCODE_FUNC interrupt(int type)
 	// however in practice it seems to break many games if we don't clear it?
 
 	TRACE_CPU("CPU_PCE interrupt: %d\n", type);
+	{ extern int g_pcecd_trace;
+	  if (g_pcecd_trace) {
+	      uint16_t vt = (type & INT_TIMER) ? pce_read16(VEC_TIMER)
+	                  : (type & INT_IRQ1)  ? pce_read16(VEC_IRQ1)
+	                  : pce_read16(VEC_IRQ2);
+	      if (vt < 0x2000 || vt == 0x4dff || vt == 0x30fd)   /* suspicious vector only */
+	          printf("[int] type=%d from pc=%04x -> vec=%04x MMR7=%02x CR=%04x RCR=%04x status=%02x pend=%08x\n",
+	                 type, CPU_PCE.PC, vt, PCE.MMR[7],
+	                 IO_VDC_REG[5].W, IO_VDC_REG[6].W, PCE.VDC.status,
+	                 (unsigned)PCE.VDC.pending_irqs);
+	  } }
 	push_16bit(CPU_PCE.PC);
 	push_8bit(CPU_PCE.P);
 	CPU_PCE.P &= ~(FL_D|FL_T);
