+# 32X-only 35 Hz panel rate: beam slower than the writer, closes the
+# scanout race without the ~20% wait-for-latch guard cost. Panel only —
+# pacing and audio stay on the 60 Hz numbers. Enable with MD32X_LCD_35HZ=1.
+MD32X_LCD_35HZ ?= 0
+ifeq ($(MD32X_LCD_35HZ),1)
+  C_DEFS += -DMD32X_LCD_35HZ=1
+endif
